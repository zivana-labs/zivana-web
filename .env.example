# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Brevo email
BREVO_API_KEY=your-smtp-key
BREVO_API_KEY_REST=xkeysib-your-rest-api-key

# Telegram bot
TELEGRAM_BOT_TOKEN=your-bot-token
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=ZivanaProtocolBot

# Cron job
CRON_SECRET=your-random-secret

# Supabase service role (server-side only, never expose to browser)
NEXT_PRIVATE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key